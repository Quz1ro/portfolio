# Configure EITHER Web3Forms (recommended without a domain) OR Resend.
# Web3Forms key is tied to the email you verify during registration.
WEB3FORMS_ACCESS_KEY=

# Optional alternative: Resend requires an approved sender for production.
# Do not commit .env.local or secrets to GitHub.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=kovalevich.vadimm@gmail.com
# Optional public site URL after deployment:
NEXT_PUBLIC_SITE_URL=
